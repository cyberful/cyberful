{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.0.0-development",
  "name": "cyberful",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberful/cyberful"
  },
  "homepage": "https://github.com/cyberful/cyberful#readme",
  "bugs": {
    "url": "https://github.com/cyberful/cyberful/issues"
  },
  "private": true,
  "scripts": {
    "check:code": "bun run script/check-code-principles.ts",
    "validate:skills": "bun run script/validate-skills.ts",
    "typecheck": "bun run check:code && bun run validate:skills && tsgo --noEmit",
    "build": "bun run script/build.ts",
    "generate-client": "bun run script/generate-client.ts",
    "cve-dictionary:acquire": "bun run script/cve-dictionary-sources.ts",
    "cve-dictionary:build": "bun run script/cve-dictionary-build.ts",
    "cve-dictionary:prepare-publication": "bun run script/cve-dictionary-publish.ts",
    "cve-dictionary:publish": "bun run script/cve-dictionary-release.ts",
    "test": "bun test --isolate --path-ignore-patterns='**/*.integration.test.ts'",
    "test:cyberful-os": "bun test --isolate --no-orphans --timeout 300000 src/subsystem/cyberful-os.integration.test.ts src/subsystem/evm/runtime.integration.test.ts",
    "test:network": "CYBERFUL_TEST_LOOPBACK=1 bun test --isolate --timeout 70000 src/subsystem/gateway/browser-profile-process.integration.test.ts",
    "test:zap": "bun test --isolate --no-orphans src/subsystem/zap/runtime.integration.test.ts",
    "test:all": "bun run test && bun run test:network && bun run test:zap",
    "dev": "bun run --conditions=browser ./src/index.ts"
  },
  "bin": {
    "cyberful": "./bin/cyberful"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.6",
    "@parcel/watcher-win32-x64": "2.6.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/mime-types": "3.0.1",
    "@types/npm-package-arg": "6.1.4",
    "@types/npmcli__arborist": "6.3.3",
    "@types/semver": "catalog:",
    "@types/which": "3.0.4",
    "@types/yargs": "17.0.35",
    "@types/yauzl": "2.10.3",
    "@typescript/native-preview": "catalog:",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.6.2",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@effect/platform-node": "catalog:",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@npmcli/arborist": "9.4.0",
    "@npmcli/config": "10.8.1",
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@parcel/watcher": "2.5.1",
    "@sigstore/bundle": "4.0.0",
    "@sigstore/core": "3.2.0",
    "@sigstore/protobuf-specs": "0.5.1",
    "@sigstore/tuf": "4.0.2",
    "@sigstore/verify": "3.1.0",
    "@solid-primitives/event-bus": "1.1.2",
    "@solid-primitives/scheduled": "1.5.2",
    "bun-pty": "0.4.8",
    "clipboardy": "4.0.0",
    "cross-spawn": "catalog:",
    "diff": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fuzzysort": "3.1.0",
    "glob": "13.0.5",
    "gray-matter": "4.0.3",
    "ignore": "7.0.5",
    "jsonc-parser": "3.3.1",
    "mime-types": "3.0.2",
    "minimatch": "10.2.5",
    "npm-package-arg": "14.0.0",
    "open": "10.1.2",
    "opentui-spinner": "catalog:",
