{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/file-processing-ledger.v1.json",
  "title": "Cyberful file processing ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "source_sha256", "authority_reference", "stages"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "component", "operation", "input_sha256", "output_sha256", "canonical_path", "principal", "network", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "component": {"type": "string", "minLength": 1, "maxLength": 256},
          "operation": {"type": "string", "minLength": 1, "maxLength": 256},
          "input_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "canonical_path": {"type": ["string", "null"], "maxLength": 2048},
          "principal": {"type": "string", "minLength": 1, "maxLength": 256},
          "network": {"enum": ["none", "loopback", "authorized-target"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    }
  }
}

