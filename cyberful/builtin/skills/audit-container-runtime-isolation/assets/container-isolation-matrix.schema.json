{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/container-isolation-matrix.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "workload", "runtime", "controls", "boundary_hypotheses"],
  "properties": {
    "format": {"const": "cyberful.container-isolation-matrix.v1"},
    "workload": {"type": "string", "minLength": 1},
    "runtime": {"type": "string", "minLength": 1},
    "controls": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["layer", "setting", "provenance", "protected_resource", "status", "evidence"], "properties": {"layer": {"enum": ["identity", "privilege", "resources", "namespaces", "host-interface", "placement"]}, "setting": {"type": "string", "minLength": 1}, "provenance": {"type": "string", "minLength": 1}, "protected_resource": {"type": "string", "minLength": 1}, "status": {"enum": ["enforced", "weakened", "absent", "unknown", "not-applicable"]}, "evidence": {"type": "array", "items": {"type": "string"}}}}},
    "boundary_hypotheses": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["foothold", "primitive", "potential_effect", "verification"], "properties": {"foothold": {"type": "string", "minLength": 1}, "primitive": {"type": "string", "minLength": 1}, "potential_effect": {"type": "string", "minLength": 1}, "verification": {"type": "string", "minLength": 1}}}}
  }
}
