{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/fraud-control-analysis.v1.json",
  "title": "Cyberful fraud control raw analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "engagement_id", "authorization_reference", "source_sha256", "limits", "summary", "coverage", "conflicts", "observations", "interpretation"],
  "properties": {
    "format": {"const": "cyberful.fraud-control-analysis.v1"},
    "engagement_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limits": {"type": "object", "additionalProperties": false, "required": ["observations", "output_bytes", "timeout_seconds"], "properties": {"observations": {"type": "integer", "minimum": 1, "maximum": 4096}, "output_bytes": {"const": 4194304}, "timeout_seconds": {"const": 10}}},
    "summary": {"$ref": "#/$defs/summary"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "conflicts": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/conflict"}},
    "observations": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/analyzed_observation"}},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "decision_counts": {"type": "object", "additionalProperties": false, "required": ["allow", "challenge", "deny", "review", "error", "not-applicable"], "properties": {"allow": {"type": "integer", "minimum": 0}, "challenge": {"type": "integer", "minimum": 0}, "deny": {"type": "integer", "minimum": 0}, "review": {"type": "integer", "minimum": 0}, "error": {"type": "integer", "minimum": 0}, "not-applicable": {"type": "integer", "minimum": 0}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["observation_count", "expected_decisions", "observed_decisions", "matches", "mismatches"], "properties": {"observation_count": {"type": "integer", "minimum": 1, "maximum": 4096}, "expected_decisions": {"$ref": "#/$defs/decision_counts"}, "observed_decisions": {"$ref": "#/$defs/decision_counts"}, "matches": {"type": "integer", "minimum": 0}, "mismatches": {"type": "integer", "minimum": 0}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["expected_controls", "observed_controls", "missing_controls", "controls"], "properties": {"expected_controls": {"$ref": "#/$defs/id_list"}, "observed_controls": {"$ref": "#/$defs/id_list"}, "missing_controls": {"$ref": "#/$defs/id_list"}, "controls": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/control_coverage"}}}},
    "id_list": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "dimension_list": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "control_coverage": {"type": "object", "additionalProperties": false, "required": ["control_id", "observation_count", "stages", "channels", "matches", "mismatches"], "properties": {"control_id": {"type": "string", "minLength": 1, "maxLength": 256}, "observation_count": {"type": "integer", "minimum": 1}, "stages": {"$ref": "#/$defs/dimension_list"}, "channels": {"$ref": "#/$defs/dimension_list"}, "matches": {"type": "integer", "minimum": 0}, "mismatches": {"type": "integer", "minimum": 0}}},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "control_id", "observed_decisions", "observation_ids"], "properties": {"scenario_id": {"type": "string", "minLength": 1, "maxLength": 256}, "control_id": {"type": "string", "minLength": 1, "maxLength": 256}, "observed_decisions": {"type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["allow", "challenge", "deny", "review", "error", "not-applicable"]}}, "observation_ids": {"type": "array", "minItems": 2, "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}},
    "text_list": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "analyzed_observation": {"type": "object", "additionalProperties": false, "required": ["observation_id", "scenario_id", "control_id", "sequence", "stage", "channel", "actor", "expected_decision", "observed_decision", "reason_codes", "signal_refs", "durable_effect", "evidence_ref", "comparison"], "properties": {"observation_id": {"type": "string", "minLength": 1, "maxLength": 256}, "scenario_id": {"type": "string", "minLength": 1, "maxLength": 256}, "control_id": {"type": "string", "minLength": 1, "maxLength": 256}, "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "stage": {"enum": ["enrollment", "authentication", "transaction-initiation", "authorization", "execution", "post-transaction", "recovery", "review"]}, "channel": {"type": "string", "minLength": 1, "maxLength": 256}, "actor": {"type": "string", "minLength": 1, "maxLength": 256}, "expected_decision": {"enum": ["allow", "challenge", "deny", "review", "error", "not-applicable"]}, "observed_decision": {"enum": ["allow", "challenge", "deny", "review", "error", "not-applicable"]}, "reason_codes": {"$ref": "#/$defs/text_list"}, "signal_refs": {"$ref": "#/$defs/text_list"}, "durable_effect": {"type": "string", "minLength": 1, "maxLength": 2048}, "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048}, "comparison": {"enum": ["match", "mismatch"]}}}
  }
}
