{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/fraud-control-observations.v1.json",
  "title": "Cyberful fraud control observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "engagement_id", "authorization_reference", "expected_controls", "observations"],
  "properties": {
    "$schema": {"const": "./fraud-control-observations.schema.json"},
    "engagement_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "expected_controls": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "observations": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "text_list": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "decision": {"enum": ["allow", "challenge", "deny", "review", "error", "not-applicable"]},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "scenario_id", "control_id", "sequence", "stage", "channel", "actor", "expected_decision", "observed_decision", "reason_codes", "signal_refs", "durable_effect", "evidence_ref"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "scenario_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "control_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "stage": {"enum": ["enrollment", "authentication", "transaction-initiation", "authorization", "execution", "post-transaction", "recovery", "review"]},
        "channel": {"type": "string", "minLength": 1, "maxLength": 256},
        "actor": {"type": "string", "minLength": 1, "maxLength": 256},
        "expected_decision": {"$ref": "#/$defs/decision"},
        "observed_decision": {"$ref": "#/$defs/decision"},
        "reason_codes": {"$ref": "#/$defs/text_list"},
        "signal_refs": {"$ref": "#/$defs/text_list"},
        "durable_effect": {"type": "string", "minLength": 1, "maxLength": 2048},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    }
  }
}
