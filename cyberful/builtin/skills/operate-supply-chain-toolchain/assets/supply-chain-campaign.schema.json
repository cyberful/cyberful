{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.dev/schemas/supply-chain-campaign.v1.json",
  "title": "Authorized supply-chain campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorized", "artifact", "output_directory", "tools", "max_tool_runs", "timeout_seconds"],
  "properties": {
    "authorized": {"const": true},
    "artifact": {"type": "string", "minLength": 1},
    "output_directory": {"type": "string", "minLength": 1},
    "tools": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["syft", "grype", "trivy", "gitleaks"]}},
    "max_tool_runs": {"type": "integer", "minimum": 1, "maximum": 4},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900}
  }
}
