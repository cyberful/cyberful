{
  "schema_version": 1,
  "entrypoint": "run_authorization_campaign.py",
  "class": "probe",
  "network": "target",
  "workflows": ["pentest", "bug-bounty"],
  "phases": ["exploit", "hacker", "verify"],
  "tools": ["curl"],
  "dependencies": {
    "commands": ["curl"],
    "python": [],
    "bootstrap": null
  },
  "effects": ["authorized-target-http-requests-via-runtime-owned-route", "writes-bounded-secret-redacted-raw-evidence"],
  "timeout_seconds": 180,
  "limits": {
    "requests": 16,
    "concurrency": 1,
    "output_bytes": 1048576
  },
  "secrets": {
    "environment": ["CYBERFUL_PROBE_AUTHORIZATION", "CYBERFUL_PROBE_COOKIE"]
  },
  "transport": {
    "authority": "runtime",
    "route": "http-proxy",
    "loopback": "direct",
    "proxy_environment": ["HTTP_PROXY", "HTTPS_PROXY"],
    "trust_environment": ["SSL_CERT_FILE", "CURL_CA_BUNDLE"]
  },
  "input": {
    "format": "json",
    "schema": "assets/authorization-campaign.schema.json"
  },
  "output": {
    "format": "json",
    "schema": "assets/authorization-campaign-evidence.schema.json",
    "raw": true
  }
}
