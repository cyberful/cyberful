  "needs": [
    {"id": "pci.scope-and-entity", "title": "Entity, reporting scope, CDE boundaries, locations, system components, and segmentation reliance", "source_refs": ["PCI DSS 4.0.1 scope", "ROC scope and environment sections"], "evidence_expectations": ["Current scope inventory and diagrams", "Entity and service-provider classification", "Segmentation rationale and validation references"], "required": true},
