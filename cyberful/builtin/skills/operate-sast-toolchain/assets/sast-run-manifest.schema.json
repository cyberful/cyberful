{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.dev/schemas/sast-run-manifest.schema.json",
  "title": "Cyberful SAST reconciliation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "$schema": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "scanner", "source_root"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "kind": { "enum": ["semgrep-json", "sarif"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "scanner": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "source_root": { "type": "string", "maxLength": 4096 }
        }
      }
    }
  }
}
