    {"value_id": "wallet-balance", "owner": "ledger-service", "authoritative_evidence": "synthetic-ledger-export"}
  ],
  "actors": [
    {"actor_id": "controlled-customer", "starting_state": "verified-test-account", "capabilities": ["initiate-sandbox-transfer"]}
  ],
  "paths": [
    {
      "path_id": "synthetic-transfer-threshold",
