{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/payment-control-matrix.v1.json",
  "title": "Cyberful payment control matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "matrix_id", "authorization_reference", "value_ceiling_minor", "currency", "cases"],
  "properties": {
    "$schema": {"type": "string"}, "matrix_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "value_ceiling_minor": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "text_list": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "lifecycle_stage", "invariant", "actor", "instrument", "beneficiary", "preconditions", "action", "expected_decision", "expected_effect", "evidence_refs", "cleanup", "stop_condition"], "properties": {"case_id": {"$ref": "#/$defs/text"}, "lifecycle_stage": {"enum": ["authorization", "capture", "transfer", "settlement", "payout", "refund", "reversal", "dispute"]}, "invariant": {"$ref": "#/$defs/text"}, "actor": {"$ref": "#/$defs/text"}, "instrument": {"$ref": "#/$defs/text"}, "beneficiary": {"$ref": "#/$defs/text"}, "preconditions": {"$ref": "#/$defs/text_list"}, "action": {"$ref": "#/$defs/text"}, "expected_decision": {"enum": ["allow", "challenge", "deny", "review"]}, "expected_effect": {"$ref": "#/$defs/text"}, "evidence_refs": {"$ref": "#/$defs/text_list"}, "cleanup": {"$ref": "#/$defs/text"}, "stop_condition": {"$ref": "#/$defs/text"}}}
  }
}
