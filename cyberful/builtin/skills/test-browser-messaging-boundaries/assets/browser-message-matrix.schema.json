{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/browser-message-matrix.v1.json",
  "title": "Cyberful browser message boundary matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_reference", "channels"],
  "properties": {
    "authority_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "transport", "sender", "receiver", "allowed_origins", "message_types", "capabilities", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "transport": {"enum": ["postMessage", "MessagePort", "BroadcastChannel", "dedicated-worker", "shared-worker", "service-worker", "extension", "native-bridge"]},
          "sender": {"type": "string", "minLength": 1, "maxLength": 256},
          "receiver": {"type": "string", "minLength": 1, "maxLength": 256},
          "allowed_origins": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 2048}},
          "message_types": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}},
          "capabilities": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 256}},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    }
  }
}

