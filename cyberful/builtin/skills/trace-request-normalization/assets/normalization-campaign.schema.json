{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/normalization-campaign.v1.json",
  "title": "Cyberful request normalization campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "campaign_id", "authority", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "authorization_reference", "allowed_origins", "max_requests", "requests_per_second", "request_timeout_seconds"],
      "properties": {
        "confirmed": {"const": true},
        "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
        "allowed_origins": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "format": "uri"}},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 12},
        "requests_per_second": {"type": "number", "minimum": 0.1, "maximum": 4},
        "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "dimension", "variant", "method", "url", "headers", "secret_headers", "body_base64"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "dimension": {"enum": ["authority", "path", "query", "method", "field", "translation", "control"]},
          "variant": {"type": "string", "minLength": 1, "maxLength": 256},
          "method": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]},
          "url": {"type": "string", "format": "uri", "maxLength": 2048},
          "headers": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "maxLength": 2048}},
          "secret_headers": {"type": "object", "maxProperties": 2, "additionalProperties": {"enum": ["CYBERFUL_PROBE_AUTHORIZATION", "CYBERFUL_PROBE_COOKIE"]}},
          "body_base64": {"type": "string", "contentEncoding": "base64", "maxLength": 87384}
        }
      }
    }
  }
}
