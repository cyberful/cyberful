{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.dev/schemas/discovery-run-manifest.schema.json",
  "title": "Cyberful content-discovery run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "$schema": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "profile", "mutation_axis", "baseline"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "profile": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "mutation_axis": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "baseline": { "type": "boolean" }
        }
      }
    }
  }
}
