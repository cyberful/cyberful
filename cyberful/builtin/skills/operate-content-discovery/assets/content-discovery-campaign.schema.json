{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.dev/schemas/content-discovery-campaign.v1.json",
  "title": "Bounded content discovery campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "authorization_reference", "allowed_origins", "target", "wordlist", "output_directory", "request_limit", "rate_per_second", "concurrency", "timeout_seconds"],
  "properties": {
    "$schema": {"const": "./content-discovery-campaign.schema.json"},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 512},
    "allowed_origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^https?://[^/?#]+/?$"}},
    "target": {"type": "string", "pattern": "^https?://.*FUZZ"},
    "wordlist": {"type": "string", "minLength": 1},
    "output_directory": {"type": "string", "minLength": 1},
    "request_limit": {"type": "integer", "minimum": 1, "maximum": 10000},
    "rate_per_second": {"type": "integer", "minimum": 1, "maximum": 250},
    "concurrency": {"type": "integer", "minimum": 1, "maximum": 50},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
  }
}
