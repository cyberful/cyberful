{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["format", "input_sha256", "authorization_reference", "transport", "executions"],
  "properties": {
    "format": {"const": "cyberful.rag-isolation-probe.raw.v1"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorization_reference": {"type": "string"},
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["route", "direct_non_loopback", "proxy_environment", "trust_environment"],
      "properties": {
        "route": {"const": "runtime-http-proxy-or-literal-loopback"}, "direct_non_loopback": {"const": false},
        "proxy_environment": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["HTTP_PROXY", "HTTPS_PROXY"]}},
        "trust_environment": {"type": ["string", "null"], "enum": ["SSL_CERT_FILE", "CURL_CA_BUNDLE", null]}
      }
    },
    "executions": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "endpoint", "corpus_id", "actor_id", "tenant_id", "marker_ids", "request_sha256", "route", "exit_code", "duration_ms", "headers_base64", "body_base64", "stderr_base64", "truncated"],
        "properties": {
          "case_id": {"type": "string"}, "endpoint": {"type": "string"}, "corpus_id": {"type": "string"},
          "actor_id": {"type": "string"}, "tenant_id": {"type": "string"},
          "marker_ids": {"type": "array", "items": {"type": "string"}},
          "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "route": {"enum": ["direct-loopback", "runtime-http-proxy"]},
          "exit_code": {"type": "integer"}, "duration_ms": {"type": "integer", "minimum": 0},
          "headers_base64": {"type": "string"}, "body_base64": {"type": "string"}, "stderr_base64": {"type": "string"},
          "truncated": {"type": "boolean"}
        }
      }
    }
  }
}
