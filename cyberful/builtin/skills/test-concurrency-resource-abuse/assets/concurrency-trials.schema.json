{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.dev/schemas/concurrency-trials.schema.json",
  "title": "Cyberful concurrency trial ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "$schema": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "control_group", "invariant", "mode", "attempts", "successful_responses", "durable_effects", "expected_max_durable_effects", "settled", "final_state", "evidence_refs"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "control_group": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "invariant": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "mode": { "enum": ["sequential", "concurrent"] },
          "attempts": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "successful_responses": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "durable_effects": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "expected_max_durable_effects": { "type": "integer", "minimum": 0, "maximum": 1000000 },
          "settled": { "type": "boolean" },
          "final_state": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        }
      }
    }
  }
}
