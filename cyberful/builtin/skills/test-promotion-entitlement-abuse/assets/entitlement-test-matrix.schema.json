{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/entitlement-test-matrix.v1.json",
  "title": "Cyberful entitlement test matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "matrix_id", "authorization_reference", "benefit_ceiling", "cases"],
  "properties": {
    "$schema": {"type": "string"}, "matrix_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 2048}, "benefit_ceiling": {"type": "string", "minLength": 1, "maxLength": 512},
    "cases": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048}, "text_list": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "benefit", "invariant", "actor", "pre_state", "sequence", "expected_state", "evidence_refs", "cleanup", "stop_condition"], "properties": {"case_id": {"$ref": "#/$defs/text"}, "benefit": {"$ref": "#/$defs/text"}, "invariant": {"$ref": "#/$defs/text"}, "actor": {"$ref": "#/$defs/text"}, "pre_state": {"$ref": "#/$defs/text"}, "sequence": {"$ref": "#/$defs/text_list"}, "expected_state": {"$ref": "#/$defs/text"}, "evidence_refs": {"$ref": "#/$defs/text_list"}, "cleanup": {"$ref": "#/$defs/text"}, "stop_condition": {"$ref": "#/$defs/text"}}}
  }
}
