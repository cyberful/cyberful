{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/transaction-trace.v1.json",
  "title": "Cyberful transaction state raw trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "engagement_id", "authorization_reference", "source_sha256", "limits", "summary", "transactions", "interpretation"],
  "properties": {
    "format": {"const": "cyberful.transaction-trace.v1"},
    "engagement_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limits": {"type": "object", "additionalProperties": false, "required": ["transactions", "events", "output_bytes", "timeout_seconds"], "properties": {"transactions": {"const": 512}, "events": {"const": 8192}, "output_bytes": {"const": 4194304}, "timeout_seconds": {"const": 10}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["transaction_count", "event_count", "transactions_with_continuity_gaps", "transactions_with_duplicate_event_ids", "transactions_with_idempotency_reuse", "terminal_state_mismatches", "net_value_mismatches"], "properties": {"transaction_count": {"type": "integer", "minimum": 1, "maximum": 512}, "event_count": {"type": "integer", "minimum": 1, "maximum": 8192}, "transactions_with_continuity_gaps": {"type": "integer", "minimum": 0}, "transactions_with_duplicate_event_ids": {"type": "integer", "minimum": 0}, "transactions_with_idempotency_reuse": {"type": "integer", "minimum": 0}, "terminal_state_mismatches": {"type": "integer", "minimum": 0}, "net_value_mismatches": {"type": "integer", "minimum": 0}}},
    "transactions": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/transaction_trace"}},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "event": {"type": "object", "additionalProperties": false, "required": ["event_id", "sequence", "component", "kind", "state_before", "state_after", "amount_delta_minor", "idempotency_key", "correlation_ids", "durable_effect", "evidence_ref"], "properties": {"event_id": {"type": "string", "minLength": 1, "maxLength": 256}, "sequence": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "component": {"type": "string", "minLength": 1, "maxLength": 256}, "kind": {"type": "string", "minLength": 1, "maxLength": 256}, "state_before": {"type": "string", "minLength": 1, "maxLength": 256}, "state_after": {"type": "string", "minLength": 1, "maxLength": 256}, "amount_delta_minor": {"type": "integer", "minimum": -1000000000000000, "maximum": 1000000000000000}, "idempotency_key": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}, "correlation_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "durable_effect": {"type": "string", "minLength": 1, "maxLength": 2048}, "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048}}},
    "continuity_gap": {"type": "object", "additionalProperties": false, "required": ["previous_event_id", "next_event_id", "previous_state_after", "next_state_before"], "properties": {"previous_event_id": {"type": "string", "minLength": 1, "maxLength": 256}, "next_event_id": {"type": "string", "minLength": 1, "maxLength": 256}, "previous_state_after": {"type": "string", "minLength": 1, "maxLength": 256}, "next_state_before": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "duplicate_event": {"type": "object", "additionalProperties": false, "required": ["event_id", "count", "sequences"], "properties": {"event_id": {"type": "string", "minLength": 1, "maxLength": 256}, "count": {"type": "integer", "minimum": 2}, "sequences": {"type": "array", "minItems": 2, "maxItems": 2048, "items": {"type": "integer", "minimum": 0, "maximum": 1000000000}}}},
    "idempotency_reuse": {"type": "object", "additionalProperties": false, "required": ["idempotency_key", "event_ids", "components", "kinds", "amount_delta_minor"], "properties": {"idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256}, "event_ids": {"type": "array", "minItems": 2, "maxItems": 2048, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "components": {"type": "array", "minItems": 1, "maxItems": 2048, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "kinds": {"type": "array", "minItems": 1, "maxItems": 2048, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "amount_delta_minor": {"type": "integer"}}},
    "computed": {"type": "object", "additionalProperties": false, "required": ["expected_terminal_state", "observed_terminal_state", "terminal_state_matches", "expected_net_delta_minor", "observed_net_delta_minor", "net_delta_matches"], "properties": {"expected_terminal_state": {"type": "string", "minLength": 1, "maxLength": 256}, "observed_terminal_state": {"type": "string", "minLength": 1, "maxLength": 256}, "terminal_state_matches": {"type": "boolean"}, "expected_net_delta_minor": {"type": "integer"}, "observed_net_delta_minor": {"type": "integer"}, "net_delta_matches": {"type": "boolean"}}},
    "transaction_trace": {"type": "object", "additionalProperties": false, "required": ["transaction_id", "currency", "trace", "continuity_gaps", "duplicate_event_ids", "idempotency_reuse", "computed"], "properties": {"transaction_id": {"type": "string", "minLength": 1, "maxLength": 256}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "trace": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"$ref": "#/$defs/event"}}, "continuity_gaps": {"type": "array", "maxItems": 2047, "items": {"$ref": "#/$defs/continuity_gap"}}, "duplicate_event_ids": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/duplicate_event"}}, "idempotency_reuse": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/idempotency_reuse"}}, "computed": {"$ref": "#/$defs/computed"}}}
  }
}
