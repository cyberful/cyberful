{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "artifacts", "markers"],
  "properties": {
    "$schema": {"const": "assets/secret-propagation-input.schema.json"},
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "system", "captured_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "system": {"type": "string", "minLength": 1, "maxLength": 256},
          "captured_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "markers": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sha256", "allowed_locations"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "allowed_locations": {
            "type": "array", "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["artifact_id", "pointer_prefix"],
              "properties": {
                "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "pointer_prefix": {"type": "string", "maxLength": 512}
              }
            }
          }
        }
      }
    }
  }
}
