{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["format", "input_sha256", "artifacts", "occurrences", "counts"],
  "properties": {
    "format": {"const": "cyberful.secret-propagation.raw.v1"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "system", "captured_at", "sha256"],
        "properties": {
          "id": {"type": "string"}, "path": {"type": "string"}, "system": {"type": "string"},
          "captured_at": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "occurrences": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["marker_id", "artifact_id", "pointer", "value_sha256", "allowed"],
        "properties": {
          "marker_id": {"type": "string"}, "artifact_id": {"type": "string"}, "pointer": {"type": "string"},
          "value_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "allowed": {"type": "boolean"}
        }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["artifacts", "markers", "occurrences", "unexpected"],
      "properties": {
        "artifacts": {"type": "integer", "minimum": 0}, "markers": {"type": "integer", "minimum": 0},
        "occurrences": {"type": "integer", "minimum": 0}, "unexpected": {"type": "integer", "minimum": 0}
      }
    }
  }
}
