{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/cache-evidence.v1.json",
  "title": "Cyberful isolated web cache raw evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "campaign_id", "authorization_reference", "isolation_token_sha256", "source_sha256", "limits", "pairs", "interpretation"],
  "properties": {
    "format": {"const": "cyberful.cache-evidence.v1"},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "isolation_token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limits": {"$ref": "#/$defs/limits"},
    "pairs": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/evidence"}},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["requests", "concurrency", "requests_per_second", "request_timeout_seconds", "campaign_timeout_seconds"],
      "properties": {
        "requests": {"type": "integer", "minimum": 2, "maximum": 12}, "concurrency": {"const": 1},
        "requests_per_second": {"type": "number", "minimum": 0.1, "maximum": 2},
        "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 20},
        "campaign_timeout_seconds": {"type": "integer", "minimum": 0, "maximum": 120}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["pair_id", "dimension", "observations"],
      "properties": {
        "pair_id": {"type": "string", "minLength": 1, "maxLength": 128}, "dimension": {"type": "string", "minLength": 1, "maxLength": 256},
        "observations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["role", "request", "transport", "response"], "properties": {"role": {"enum": ["prime", "observe"]}, "request": {"$ref": "#/$defs/request"}, "transport": {"$ref": "#/$defs/transport"}, "response": {"$ref": "#/$defs/response"}}}}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "url", "headers", "secret_headers", "body_bytes", "body_sha256", "request_sha256"],
      "properties": {
        "method": {"enum": ["GET", "HEAD", "POST"]}, "url": {"type": "string", "format": "uri", "maxLength": 2048},
        "headers": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {"type": "string", "minLength": 1, "maxLength": 2048}}}},
        "secret_headers": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/secret_header"}},
        "body_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "secret_header": {
      "type": "object", "additionalProperties": false, "required": ["name", "environment", "value_sha256"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "environment": {"enum": ["CYBERFUL_PROBE_AUTHORIZATION", "CYBERFUL_PROBE_COOKIE"]}, "value_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["return_code", "timed_out", "limit_exceeded", "elapsed_ms", "http_status", "route", "stderr", "stderr_redactions"],
      "properties": {
        "return_code": {"type": "integer"}, "timed_out": {"type": "boolean"},
        "limit_exceeded": {"enum": [null, "stdout", "stderr", "response headers", "response body"]},
        "elapsed_ms": {"type": "integer", "minimum": 0}, "http_status": {"type": ["integer", "null"], "minimum": 0, "maximum": 599},
        "route": {"enum": ["direct-loopback", "cyberful-os-proxy"]}, "stderr": {"type": "string", "maxLength": 4096}, "stderr_redactions": {"type": "integer", "minimum": 0}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["headers_base64", "headers_bytes", "headers_truncated", "headers_redactions", "body_base64", "body_bytes", "body_truncated", "body_redactions"],
      "properties": {
        "headers_base64": {"type": "string", "contentEncoding": "base64", "maxLength": 21848}, "headers_bytes": {"type": "integer", "minimum": 0, "maximum": 16384},
        "headers_truncated": {"type": "boolean"}, "headers_redactions": {"type": "integer", "minimum": 0},
        "body_base64": {"type": "string", "contentEncoding": "base64", "maxLength": 21848}, "body_bytes": {"type": "integer", "minimum": 0, "maximum": 16384},
        "body_truncated": {"type": "boolean"}, "body_redactions": {"type": "integer", "minimum": 0}
      }
    }
  }
}
