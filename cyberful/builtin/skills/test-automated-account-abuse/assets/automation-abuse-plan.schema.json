{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/automation-abuse-plan.v1.json",
  "title": "Cyberful automation abuse plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "experiment_id", "authorization_reference", "limits", "controlled_identities", "cases"],
  "properties": {
    "$schema": {"type": "string"}, "experiment_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "limits": {"type": "object", "additionalProperties": false, "required": ["requests", "accounts", "messages", "concurrency", "duration_seconds"], "properties": {"requests": {"type": "integer", "minimum": 1, "maximum": 1000}, "accounts": {"type": "integer", "minimum": 1, "maximum": 100}, "messages": {"type": "integer", "minimum": 0, "maximum": 100}, "concurrency": {"type": "integer", "minimum": 1, "maximum": 10}, "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}},
    "controlled_identities": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "cases": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048}, "text_list": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/text"}},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "surface", "invariant", "automation_dimension", "action", "expected_control", "authoritative_evidence", "cleanup", "stop_condition"], "properties": {"case_id": {"$ref": "#/$defs/text"}, "surface": {"$ref": "#/$defs/text"}, "invariant": {"$ref": "#/$defs/text"}, "automation_dimension": {"$ref": "#/$defs/text"}, "action": {"$ref": "#/$defs/text"}, "expected_control": {"$ref": "#/$defs/text"}, "authoritative_evidence": {"$ref": "#/$defs/text_list"}, "cleanup": {"$ref": "#/$defs/text"}, "stop_condition": {"$ref": "#/$defs/text"}}}
  }
}
