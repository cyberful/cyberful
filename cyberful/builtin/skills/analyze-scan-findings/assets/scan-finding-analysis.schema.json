{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.dev/schemas/scan-finding-analysis.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "analysis_id", "scope_reference", "scan_files", "max_findings", "max_total_bytes", "timeout_seconds", "output_limit_bytes"],
  "properties": {
    "$schema": {"const": "./scan-finding-analysis.schema.json"},
    "analysis_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "scope_reference": {"type": "string", "minLength": 1, "maxLength": 512},
    "scan_files": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "format"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}, "format": {"enum": ["sarif-2.1", "normalized-json"]}}}
    },
    "max_findings": {"type": "integer", "minimum": 1, "maximum": 100000},
    "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "output_limit_bytes": {"type": "integer", "minimum": 1024, "maximum": 8388608}
  }
}
