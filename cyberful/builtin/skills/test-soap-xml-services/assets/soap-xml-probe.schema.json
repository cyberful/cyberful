{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["constraints", "cases"],
  "properties": {
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_reference", "expires_at", "allowed_origins", "max_requests", "requests_per_second", "allowed_effects", "actor_id", "tenant_id"],
      "properties": {
        "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 1024},
        "expires_at": {"type": "string", "format": "date-time"},
        "allowed_origins": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^https?://"}},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 20},
        "requests_per_second": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "allowed_effects": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "endpoint", "soap_version", "action", "envelope", "headers", "effect", "actor_id", "tenant_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "endpoint": {"type": "string", "pattern": "^https?://"},
          "soap_version": {"enum": ["1.1", "1.2"]},
          "action": {"type": "string", "maxLength": 1024},
          "envelope": {"type": "string", "minLength": 1, "maxLength": 65536},
          "headers": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": "string", "maxLength": 1024}},
          "effect": {"type": "string", "minLength": 1, "maxLength": 64},
          "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    }
  }
}
