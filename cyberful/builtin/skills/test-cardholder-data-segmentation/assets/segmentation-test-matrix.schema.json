{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/segmentation-test-matrix.v1.json",
  "title": "Cyberful PCI DSS segmentation test matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "engagement_id", "standard_version", "authorization_reference", "entity_type", "segmentation_used", "methods", "cases", "coverage_gaps"],
  "properties": {
    "format": {"const": "cyberful.segmentation-test-matrix.v1"},
    "engagement_id": {"$ref": "#/$defs/id"},
    "standard_version": {"const": "PCI DSS 4.0.1"},
    "authorization_reference": {"$ref": "#/$defs/text"},
    "entity_type": {"enum": ["merchant", "service-provider", "multi-tenant-service-provider"]},
    "segmentation_used": {"const": true},
    "methods": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/method"}},
    "cases": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"$ref": "#/$defs/case"}},
    "coverage_gaps": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "text_list": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "method": {"type": "object", "additionalProperties": false, "required": ["method_id", "technology", "population", "enforcement_points", "configuration_evidence"], "properties": {"method_id": {"$ref": "#/$defs/id"}, "technology": {"$ref": "#/$defs/text"}, "population": {"$ref": "#/$defs/text_list"}, "enforcement_points": {"$ref": "#/$defs/text_list"}, "configuration_evidence": {"$ref": "#/$defs/text_list"}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["case_id", "method_id", "source_vantage", "protected_destination", "identity", "protocol_family", "expected_invariant", "sampling_rationale", "status", "evidence_refs", "cleanup_evidence"], "properties": {"case_id": {"$ref": "#/$defs/id"}, "method_id": {"$ref": "#/$defs/id"}, "source_vantage": {"$ref": "#/$defs/text"}, "protected_destination": {"$ref": "#/$defs/text"}, "identity": {"$ref": "#/$defs/text"}, "protocol_family": {"$ref": "#/$defs/text"}, "expected_invariant": {"$ref": "#/$defs/text"}, "sampling_rationale": {"$ref": "#/$defs/text"}, "status": {"enum": ["planned", "supported-isolation", "contradicted-isolation", "inconclusive", "blocked"]}, "evidence_refs": {"$ref": "#/$defs/text_list"}, "cleanup_evidence": {"$ref": "#/$defs/text_list"}}},
    "gap": {"type": "object", "additionalProperties": false, "required": ["method_or_population", "reason", "owner", "next_discriminator"], "properties": {"method_or_population": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"}, "next_discriminator": {"$ref": "#/$defs/text"}}}
  }
}
