{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.dev/schemas/event-ledger.schema.json",
  "title": "Cyberful realtime event ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["streams"],
  "properties": {
    "$schema": { "type": "string" },
    "streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream_id", "principal", "tenant", "channel", "expected_event_ids", "observations"],
        "properties": {
          "stream_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "principal": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "tenant": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "channel": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "expected_event_ids": {
            "type": "array",
            "maxItems": 100000,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["observation_id", "event_id", "sequence", "delivery_order", "expected", "actual", "replay", "evidence_ref"],
              "properties": {
                "observation_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "event_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
                "sequence": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 },
                "delivery_order": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
                "expected": { "enum": ["deliver", "reject"] },
                "actual": { "enum": ["delivered", "rejected", "indeterminate"] },
                "replay": { "type": "boolean" },
                "evidence_ref": { "type": "string", "minLength": 1, "maxLength": 2048 }
              }
            }
          }
        }
      }
    }
  }
}
