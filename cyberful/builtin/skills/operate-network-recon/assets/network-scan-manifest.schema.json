{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.dev/schemas/network-scan-manifest.schema.json",
  "title": "Cyberful network scan reconciliation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "$schema": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "vantage", "observed_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "kind": { "enum": ["nmap-xml", "masscan-json"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "vantage": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "observed_at": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    }
  }
}
