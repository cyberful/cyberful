{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberful.local/schemas/deserialization-harness.v1.json",
  "title": "Cyberful loopback deserialization harness",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "campaign_id", "authority", "fixtures"],
  "properties": {
    "$schema": {"type": "string"},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "authorization_reference", "allowed_origin", "max_requests", "request_timeout_seconds"],
      "properties": {
        "confirmed": {"const": true},
        "authorization_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
        "allowed_origin": {"type": "string", "format": "uri"},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 8},
        "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "format", "expected_boundary", "url", "content_type", "secret_headers", "body_base64"],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "format": {"enum": ["json", "yaml", "xml", "binary", "language-native", "custom"]},
          "expected_boundary": {"type": "string", "minLength": 1, "maxLength": 256},
          "url": {"type": "string", "format": "uri", "maxLength": 2048},
          "content_type": {"type": "string", "minLength": 1, "maxLength": 256},
          "secret_headers": {"type": "object", "maxProperties": 1, "additionalProperties": {"const": "CYBERFUL_LAB_AUTHORIZATION"}},
          "body_base64": {"type": "string", "contentEncoding": "base64", "maxLength": 87384}
        }
      }
    }
  }
}

