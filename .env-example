# Cyberful local runtime
CYBERFUL_OS_DIR=./mcps/cyberful-os
CYBERFUL_OS_MCP_ENABLED=1
CYBER_BROWSER_MCP_ENABLED=1
# ── Browser profile compatibility ────────────────────────────────────────────
# Cyberful embeds the agent-browser 0.34.0-cyberful.3 fork and provisions compatible Chrome when required. Existing channel
# and profile variables remain accepted; never point a Cyberful identity at a personal daily-use profile.
CYBER_BROWSER_CHANNEL=chromium
# Put dedicated profile overrides in the `.env` of the directory that launches Cyberful:
#   CYBER_BROWSER_CHANNEL=chrome
#   CYBER_BROWSER_USER_DATA_DIR=/path/to/.cyberful-chrome/<engagement>
#   CYBER_BROWSER_CHROME_EXECUTABLE=/path/to/Google Chrome
# Prefer `cyberful browser-1` through `browser-5` for login seeding, then fully close that browser.
CYBER_BROWSER_CLEAR_COOKIES_ON_START=false
# ── Optional autonomous CAPTCHA solver ───────────────────────────────────────
# The bundled plugin remains visible without credentials and then fails explicitly to the human fallback.
# Supported providers: auto, capsolver, 2captcha.
# CYBER_BROWSER_CAPTCHA_PROVIDER=capsolver
# CYBER_BROWSER_CAPTCHA_API_KEY=
# Headless OWASP ZAP is prepared by the startup preflight and starts automatically per engagement.
# The browser proxy, CA trust, MCP key, and API key are wired by Cyberful without host-side setup.
CYBER_ZAP_ENABLED=1
CYBER_BROWSER_THROUGH_ZAP=1
# Native headless Ghidra shares the engagement container and persists its project store.
# Code Audit gives the complete container --network none; live workflows keep normal networking.
CYBER_GHIDRA_ENABLED=1
CYBER_GHIDRA_STARTUP_TIMEOUT_SECONDS=300

# ── Pi inference providers ───────────────────────────────────────────────────
# Provider routes, models, subagent limits, fallback policy, and trusted
# instruction roots belong in settings.yaml, never in this file.
# Environment-authenticated providers reference a variable name there. Put the
# corresponding secret value in the real environment or a private .env:
# ZAI_API_KEY=
