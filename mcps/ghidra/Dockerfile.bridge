# ── Ghidra MCP Stdio Bridge Image ────────────────────────────────
# Carries MCP bytes between one phase gateway and the engagement-owned Ghidra
# service while sharing only that service's loopback network namespace.
# → mcps/ghidra/ghidra_bridge.py — implements the authenticated byte bridge.
# @docs/runtimes/ghidra.md
# ─────────────────────────────────────────────────────────────────

FROM python:3.12-alpine3.22

RUN addgroup -g 10001 cyberful && adduser -D -u 10001 -G cyberful cyberful
COPY ghidra_bridge.py /opt/cyberful-ghidra/ghidra_bridge.py

ENV CYBER_GHIDRA_HOST=127.0.0.1 \
    CYBER_GHIDRA_PORT=47100 \
    PYTHONUNBUFFERED=1

USER cyberful
ENTRYPOINT ["python3", "/opt/cyberful-ghidra/ghidra_bridge.py"]
