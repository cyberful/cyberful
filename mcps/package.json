{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "cyberful-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberful/cyberful"
  },
  "homepage": "https://github.com/cyberful/cyberful#readme",
  "bugs": {
    "url": "https://github.com/cyberful/cyberful/issues"
  },
  "bin": {
    "cyberful-os": "./cyberful-os/bin/cyberful-os",
    "cyberful-os-build": "./cyberful-os/bin/cyberful-os-build",
    "cyberful-os-container": "./cyberful-os/bin/cyberful-os-container",
    "cyber-browser": "./browser/bin/cyber-browser",
    "agent-browser-plugin-captcha": "./browser/bin/agent-browser-plugin-captcha"
  },
  "scripts": {
    "mcp": "cyberful-os/bin/cyberful-os",
    "build": "cyberful-os/bin/cyberful-os-build",
    "runtime:build": "cyberful-os/bin/cyberful-os-build",
    "container": "cyberful-os/bin/cyberful-os-container",
    "browser": "browser/bin/cyber-browser",
    "browser:install": "browser/bin/cyber-browser install",
    "test:browser": "bun test browser/plugin-captcha/agent-browser-plugin-captcha.test.mjs && browser/bin/cyber-browser --version && browser/bin/agent-browser-plugin-captcha --version"
  },
  "dependencies": {
    "agent-browser": "https://github.com/cyberful/agent-browser/releases/download/v0.34.0-cyberful.3/agent-browser-0.34.0-cyberful.3.tgz"
  }
}
